{
  "name": "kamel-ride-analytics",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev -w @kamel/server",
    "migrate": "npm run migrate -w @kamel/server",
